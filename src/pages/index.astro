---
import Band from '../components/Band.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle}>

  <section class="intro intro--title container center">
    <div class="intro__title-wrap">
      <p class="eyebrow" style="color:#5500ff;">Portfolio</p>
      <h1 class="intro__title" style="color:#ffffff;">Kayson Werner</h1>
      <p class="intro__tagline" style="color:#e0d9ff;">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
</p>
    </div>
  </section>

  <section id="projects" class="section container center">
    <div class="section__header">
      <h2 style="color:#ffffff;">Featured Projects</h2>
      <p style="color:#d9b3ff;">A selection of work I’m proud of.</p>
    </div>

    <div class="grid grid--three center">
      <article class="card center" style="background-color:#1a0d2f;">
        <img src="/img/picture_placeholder.png" alt="Project preview" />
        <div class="card__content">
          <h3 style="color:#ffffff;">Project One</h3>
          <p style="color:#e0d9ff;">A short description explaining the purpose, tools, and outcome.</p>
          <a href="#" class="card__link">View Project →</a>
        </div>
      </article>

      <article class="card center" style="background-color:#1a0d2f;">
        <img src="/img/picture_placeholder.png" alt="Project preview" />
        <div class="card__content">
          <h3 style="color:#ffffff;">Project Two</h3>
          <p style="color:#e0d9ff;">A short description explaining the purpose, tools, and outcome.</p>
          <a href="#" class="card__link">View Project →</a>
        </div>
      </article>

      <article class="card center" style="background-color:#1a0d2f;">
        <img src="/img/picture_placeholder.png" alt="Project preview" />
        <div class="card__content">
          <h3 style="color:#ffffff;">Project Three</h3>
          <p style="color:#e0d9ff;">A short description explaining the purpose, tools, and outcome.</p>
          <a href="#" class="card__link">View Project →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="center">
    <Band bandTitle="About Me" bandColor="#c099ff">
      <p style="color:#ffffff;">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>
    </Band>
  </section>

  <section id="contact" class="cta center" style="background-color:#1a0d2f; padding:2rem; border-radius:10px; cta">
    <div class="container">
      <h2 style="color:#ffffff;">Let’s Work Together</h2>
      <p style="color:#e0d9ff;">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
      <a href="mailto:kaysonwerner9@gmail.com" class="btn">Get In Touch</a>
    </div>
  </section>

</BaseLayout>

